{
  "name": "cert-studio",
  "version": "0.1.0",
  "description": "中国音乐学院考级证书批量获取与分发工具(本地使用,仅限查询本人或已授权考生)",
  "main": "dist-electron/main.js",
  "private": true,
  "author": "cert-studio contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json && vite build && tsc -p tsconfig.electron.json && electron-builder",
    "electron:dev": "vite --mode electron",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
